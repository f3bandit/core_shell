@@ -0,0 +1,256 @@
+/*
+ *  nextpnr -- Next Generation Place and Route
+ *
+ *  Copyright (C) 2026 f3bandit
+ *
+ *  Placing a small design into an existing (stock) Cyclone V bitstream.
+ *
+ *  NPNR_BASE_RBF=<core.rbf>      the bitstream to start from: its used logic blocks and routing are off-limits,
+ *                                and the output is the base with the new design added (not a blank chip)
+ *  NPNR_TAPS=<PIN>,<PIN>,...     package pins whose input (the pin's DATAIN node) a MISTRAL_TAP cell
+ *                                (attribute PIN="<PIN>") can read, even though the base already uses the pin
+ *  NPNR_SINKS=<NAME>=<RNODE>,... routing nodes a MISTRAL_SINK cell (attribute NODE="<NAME>") drives, taking them
+ *                                over from the base (e.g. the HPS UART's RXD input node)
+ *  NPNR_FREE_ALMS=x,y,z;...      ALMs the base leaves unused inside its own logic blocks, open to the new design's
+ *                                LUTs only (no flip-flops: those share the block's clock and enable lines)
+ *
+ *  Permission to use, copy, modify, and/or distribute this software for any
+ *  purpose with or without fee is hereby granted, provided that the above
+ *  copyright notice and this permission notice appear in all copies.
+ *
+ *  THE SOFTWARE IS PROVIDED "AS IS" AND THE AUTHOR DISCLAIMS ALL WARRANTIES
+ *  WITH REGARD TO THIS SOFTWARE INCLUDING ALL IMPLIED WARRANTIES OF
+ *  MERCHANTABILITY AND FITNESS. IN NO EVENT SHALL THE AUTHOR BE LIABLE FOR
+ *  ANY SPECIAL, DIRECT, INDIRECT, OR CONSEQUENTIAL DAMAGES OR ANY DAMAGES
+ *  WHATSOEVER RESULTING FROM LOSS OF USE, DATA OR PROFITS, WHETHER IN AN
+ *  ACTION OF CONTRACT, NEGLIGENCE OR OTHER TORTIOUS ACTION, ARISING OUT OF
+ *  OR IN CONNECTION WITH THE USE OR PERFORMANCE OF THIS SOFTWARE.
+ */
+
+#include <cstdlib>
+#include <fstream>
+#include <iterator>
+#include <sstream>
+
+#include "log.h"
+#include "nextpnr.h"
+
+NEXTPNR_NAMESPACE_BEGIN
+
+using namespace mistral;
+
+static std::vector<std::string> split(const std::string &s, char c)
+{
+    std::vector<std::string> out;
+    std::stringstream ss(s);
+    std::string item;
+    while (std::getline(ss, item, c))
+        if (!item.empty())
+            out.push_back(item);
+    return out;
+}
+
+CycloneV::rnode_t Arch::parse_rnode(const std::string &s) const
+{
+    // TYPE.xxx.yyy.zzzz, as CycloneV::rn2s prints it
+    auto f = split(s, '.');
+    if (f.size() != 4)
+        log_error("bad routing node name '%s'\n", s.c_str());
+    auto t = id2rn_t.find(id(f[0]));
+    if (t == id2rn_t.end())
+        log_error("unknown routing node type in '%s'\n", s.c_str());
+    return CycloneV::rnode(t->second, std::stoi(f[1]), std::stoi(f[2]), std::stoi(f[3]));
+}
+
+void Arch::init_base()
+{
+    const char *base = getenv("NPNR_BASE_RBF");
+    if (!base || !*base)
+        return;
+    std::ifstream f(base, std::ios::binary);
+    if (!f)
+        log_error("can't read base bitstream %s\n", base);
+    base_rbf.assign(std::istreambuf_iterator<char>(f), std::istreambuf_iterator<char>());
+    cyclonev->rbf_load(base_rbf.data(), base_rbf.size());
+    have_base = true;
+
+    // Everything the base routes through, and every logic/memory/DSP block it connects to
+    int links = 0;
+    for (auto &l : cyclonev->route_all_active_links()) {
+        links++;
+        for (auto rn : {l.first, l.second}) {
+            base_blocked.insert(WireId(rn));
+            auto pn = cyclonev->rnode_to_pnode(rn);
+            if (!pn)
+                continue;
+            auto bt = CycloneV::pn2bt(pn);
+            if (bt == CycloneV::LAB || bt == CycloneV::MLAB || bt == CycloneV::M10K || bt == CycloneV::DSP)
+                base_tiles.insert(int(CycloneV::pn2p(pn)));
+        }
+    }
+
+    // Shared nets: the base's routing tree under a node (a global clock) usable by the new design, but only
+    // through the links the base already uses, so nothing the base depends on is re-pointed
+    if (const char *share = getenv("NPNR_SHARE")) {
+        dict<WireId, std::vector<WireId>> down;
+        for (auto &l : cyclonev->route_all_active_links()) {
+            down[WireId(l.first)].push_back(WireId(l.second));
+            base_src[WireId(l.second)] = WireId(l.first);
+        }
+        for (auto &root : split(share, ',')) {
+            std::vector<WireId> todo{WireId(parse_rnode(root))};
+            int n = 0;
+            while (!todo.empty()) {
+                WireId w = todo.back();
+                todo.pop_back();
+                if (shared.count(w))
+                    continue;
+                shared.insert(w);
+                base_blocked.erase(w);
+                n++;
+                if (down.count(w))
+                    for (auto d : down.at(w))
+                        todo.push_back(d);
+            }
+            log_info("shared %s: %d routing nodes\n", root.c_str(), n);
+        }
+    }
+
+    // Block: more base nodes, one per line (e.g. clock-mux leaves only a newer Mistral decodes)
+    if (const char *bf = getenv("NPNR_BLOCK_FILE")) {
+        std::ifstream in(bf);
+        std::string line;
+        int n = 0;
+        while (std::getline(in, line))
+            if (!line.empty()) {
+                base_blocked.insert(WireId(parse_rnode(line)));
+                n++;
+            }
+        log_info("blocked %d more nodes from %s\n", n, bf);
+    }
+
+    // Free: base nodes released for the new design (a private wire into a node it takes over)
+    if (const char *fr = getenv("NPNR_FREE")) {
+        for (auto &n : split(fr, ','))
+            base_blocked.erase(WireId(parse_rnode(n)));
+    }
+
+    // Taps: a pin's input (PIN) or a routing node (NAME=RNODE), readable by the new design
+    if (const char *taps = getenv("NPNR_TAPS")) {
+        for (auto &pin : split(taps, ',')) {
+            if (pin.find('=') != std::string::npos) {
+                auto kv = split(pin, '=');
+                WireId w(parse_rnode(kv.at(1)));
+                BelId bel = add_bel(CycloneV::rn2x(w.node), CycloneV::rn2y(w.node), idf("TAP_%s", kv[0].c_str()),
+                                    id_MISTRAL_TAP);
+                add_bel_pin(bel, id_Q, PORT_OUT, w);
+                base_blocked.erase(w);
+                tap_bels[id(kv[0])] = bel;
+                log_info("tap %s: %s\n", kv[0].c_str(), kv[1].c_str());
+                continue;
+            }
+            auto pin_info = cyclonev->pin_find_name(pin);
+            if (!pin_info)
+                log_error("tap: unknown pin %s\n", pin.c_str());
+            BelId io = get_io_pin_bel(pin_info);
+            if (io == BelId())
+                log_error("tap: pin %s has no IO block\n", pin.c_str());
+            WireId w = getBelPinWire(io, id_O);
+            if (w == WireId())
+                log_error("tap: pin %s has no input node\n", pin.c_str());
+            Loc l = getBelLocation(io);
+            BelId bel = add_bel(l.x, l.y, idf("TAP_%s", pin.c_str()), id_MISTRAL_TAP);
+            add_bel_pin(bel, id_Q, PORT_OUT, w);
+            base_blocked.erase(w);
+            tap_bels[id(pin)] = bel;
+            log_info("tap %s: %s\n", pin.c_str(), CycloneV::rn2s(w.node).c_str());
+        }
+    }
+    // Sinks: base nodes the new design takes over
+    if (const char *sinks = getenv("NPNR_SINKS")) {
+        for (auto &item : split(sinks, ',')) {
+            auto kv = split(item, '=');
+            if (kv.size() != 2)
+                log_error("sink: expected NAME=RNODE, got %s\n", item.c_str());
+            WireId w;
+            if (kv[1].compare(0, 4, "PIN:") == 0) {
+                // a pin's output data input (open-drain pins: 0 pulls the line low, 1 lets it go)
+                auto pin_info = cyclonev->pin_find_name(kv[1].substr(4));
+                BelId io = pin_info ? get_io_pin_bel(pin_info) : BelId();
+                if (io == BelId())
+                    log_error("sink: unknown pin %s\n", kv[1].c_str());
+                w = getBelPinWire(io, id_I);
+            } else
+                w = WireId(parse_rnode(kv[1]));
+            if (!wires.count(w))
+                log_error("sink: no routing node %s\n", kv[1].c_str());
+            BelId bel = add_bel(CycloneV::rn2x(w.node), CycloneV::rn2y(w.node), idf("SINK_%s", kv[0].c_str()),
+                                id_MISTRAL_SINK);
+            add_bel_pin(bel, id_D, PORT_IN, w);
+            base_blocked.erase(w);
+            sink_bels[id(kv[0])] = bel;
+            log_info("sink %s: %s\n", kv[0].c_str(), CycloneV::rn2s(w.node).c_str());
+        }
+    }
+    // Only these logic block positions may be used (x,y;x,y;...), e.g. the ones the shared clock reaches
+    if (const char *only = getenv("NPNR_ONLY_TILES")) {
+        for (auto &xy : split(only, ';')) {
+            auto v = split(xy, ',');
+            only_tiles.insert(int(CycloneV::xy2pos(std::stoi(v.at(0)), std::stoi(v.at(1)))));
+        }
+        log_info("placement limited to %d logic blocks\n", int(only_tiles.size()));
+    }
+
+    if (const char *fa = getenv("NPNR_FREE_ALMS")) {
+        for (auto &xyz : split(fa, ';')) {
+            auto v = split(xyz, ',');
+            free_alms.insert(int(CycloneV::xy2pos(std::stoi(v.at(0)), std::stoi(v.at(1)))) * 16 + std::stoi(v.at(2)));
+        }
+        log_info("%d unused ALMs in the base's blocks open to LUTs\n", int(free_alms.size()));
+    }
+
+    // Any other block (clock buffers, ...) with a pin on the base's routing is the base's
+    for (auto &w : wires)
+        if (base_blocked.count(w.first))
+            for (auto &bp : w.second.bel_pins)
+                if (!bel_data(bp.bel).type.in(id_MISTRAL_TAP, id_MISTRAL_SINK))
+                    base_bels.insert(bp.bel);
+    log_info("base %s: %d routing links, %d routing nodes and %d logic/memory blocks off-limits\n", base, links,
+             int(base_blocked.size()), int(base_tiles.size()));
+}
+
+bool Arch::base_bel_blocked(BelId bel) const
+{
+    if (!have_base)
+        return false;
+    if (base_bels.count(bel))
+        return true;
+    IdString t = bel_data(bel).type;
+    bool logic = t.in(id_MISTRAL_COMB, id_MISTRAL_MCOMB, id_MISTRAL_FF, id_MISTRAL_M10K);
+    if (t == id_MISTRAL_COMB && free_alms.count(int(bel.pos) * 16 + bel_data(bel).lab_data.alm))
+        return false;
+    if (logic && !only_tiles.empty() && !only_tiles.count(int(bel.pos)))
+        return true;
+    return logic && base_tiles.count(int(bel.pos));
+}
+
+void Arch::bind_base_cells()
+{
+    for (auto &cell : cells) {
+        CellInfo *ci = cell.second.get();
+        if (ci->type == id_MISTRAL_TAP || ci->type == id_MISTRAL_SINK) {
+            bool tap = ci->type == id_MISTRAL_TAP;
+            IdString key = id(ci->attrs.count(tap ? id_PIN : id_NODE)
+                                      ? ci->attrs.at(tap ? id_PIN : id_NODE).as_string()
+                                      : std::string());
+            auto &m = tap ? tap_bels : sink_bels;
+            auto it = m.find(key);
+            if (it == m.end())
+                log_error("%s '%s' names %s '%s', which NPNR_%s doesn't list\n", tap ? "tap" : "sink", nameOf(ci),
+                          tap ? "pin" : "node", key.c_str(this), tap ? "TAPS" : "SINKS");
+            bindBel(it->second, ci, STRENGTH_LOCKED);
+        }
+    }
+}
+
+NEXTPNR_NAMESPACE_END
